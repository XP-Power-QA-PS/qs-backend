# ===================================================================
# Render Web Service Environment Variables Cheat Sheet
# Copy các giá trị này vào Environment Variables trên Dashboard Render
# ===================================================================

# Profile & Port
SPRING_PROFILES_ACTIVE=prod
PORT=8080

# Database Configuration (Từ Render PostgreSQL)
# Lưu ý: Thêm 'jdbc:' vào đầu Internal Database URL và '?sslmode=require' ở đuôi
DB_URL=jdbc:postgresql://<INTERNAL_DB_HOST>:5432/qs_db?sslmode=require
DB_USERNAME=qs_admin
DB_PASSWORD=<RENDER_POSTGRES_PASSWORD>

# Redis Configuration (Từ Upstash Redis)
REDIS_HOST=<UPSTASH_ENDPOINT>
REDIS_PORT=6379
REDIS_PASSWORD=<UPSTASH_PASSWORD>
REDIS_SSL_ENABLED=true

# Security & JWT
JWT_SECRET=super_secure_jwt_secret_key_with_at_least_32_characters_long
JWT_ACCESS_TOKEN_EXPIRATION=3600000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# Initial Admin Account
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=admin123@Password
ADMIN_DEFAULT_EMAIL=admin@example.com

# CORS Configuration (Domain Vercel của bạn)
CORS_ALLOWED_ORIGINS=https://qs-frontend.vercel.app,http://localhost:5173
