# ===================================================================
# Environment Variables Cheat Sheet (Self-Hosted / Production / Docker)
# ===================================================================

# Profile & Port
SPRING_PROFILES_ACTIVE=prod
PORT=8080

# Database Configuration (PostgreSQL Self-hosted / Docker)
DB_URL=jdbc:postgresql://localhost:5432/qs_db
DB_USERNAME=qs_admin
DB_PASSWORD=qs_password

# Redis Configuration (Self-hosted / Docker)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false

# Security & JWT
JWT_SECRET=super_secure_jwt_secret_key_with_at_least_32_characters_long
JWT_ACCESS_TOKEN_EXPIRATION=3600000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# Initial Admin Account
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=admin123@Password
ADMIN_DEFAULT_EMAIL=admin@example.com

# CORS Configuration (Domain Vercel của bạn)
CORS_ALLOWED_ORIGINS=https://qs-frontend.vercel.app,http://localhost:5173

# Mail Configuration (Gửi email mời họp & thông báo)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-character-app-password
MAIL_FROM=noreply.qs.system@gmail.com
MAIL_FROM_NAME=QS Quality System
MAIL_ENABLED=true

# MinIO / S3 Configuration
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=qs_minio_admin
MINIO_SECRET_KEY=qs_minio_password
MINIO_BUCKET_NAME=qs-bucket
MINIO_PRESIGNED_EXPIRATION_MINUTES=15
